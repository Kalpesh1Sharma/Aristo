# Obtain from https://app.neatlogs.com (optional for local baseline; required for exported traces)
NEATLOGS_API_KEY=
# Groq free-tier inference. Live requests are disabled unless explicitly enabled.
LLM_API_KEY=
LLM_API_URL=https://api.groq.com/openai/v1/chat/completions
LLM_MODEL=openai/gpt-oss-20b

# MarginGhost cost and usage controls
DEMO_MODE=false
LLM_MODE=offline
LLM_MAX_REQUESTS_PER_RUN=2
LLM_TIMEOUT_MS=20000
LLM_MAX_OUTPUT_TOKENS=1800
LLM_PAID_FALLBACK=false

# Invite-only Vercel judge preview. Keep disabled until protections are independently verified.
JUDGE_PREVIEW_ENABLED=false
JUDGE_PREVIEW_PASSWORD_HASH=
JUDGE_PREVIEW_SESSION_SECRET=
JUDGE_PREVIEW_DAILY_LIMIT=30

# Upstash Redis REST credentials for persistent atomic auth and processing limits.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
